---
import { landingContent } from "../content";
import PlatformAvailability from "../components/PlatformAvailability.astro";
import SeoHead from "../components/SeoHead.astro";
import "../styles/global.css";

const content = landingContent;
// Inline the SVG mark as a data URI so we don't need the brand package path at build time
const chronicleMarkSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none"><path d="M38 12H19C11.8 12 8 16 8 22s3.8 10 11 10h12c5.5 0 8 2.7 8 7" stroke="#0f62fe" stroke-width="8" stroke-linecap="round"/><path d="M38 12H19c-4.4 0-7.5 1.5-9.2 4.2" stroke="#78a9ff" stroke-width="8" stroke-linecap="round"/><circle cx="38" cy="12" r="6" fill="#a6c8ff"/><circle cx="39" cy="39" r="5" fill="#78a9ff"/></svg>`;
const chronicleMarkUrl = `data:image/svg+xml,${encodeURIComponent(chronicleMarkSvg)}`;

const formatShowcase = [
  { ext: "PNG", filename: "campaign.png", kind: "image", profession: "Graphic designer", detail: "Campaign artwork", change: "Palette, crop, and lockup refined" },
  { ext: "JPG", filename: "hero-shoot.jpg", kind: "photo", profession: "Photographer", detail: "Photography export", change: "Light, colour, and framing evolved" },
  { ext: "PSD", filename: "launch-poster.psd", kind: "layers", profession: "Visual designer", detail: "Layered design document", change: "Five passes from layout to final" },
  { ext: "PSB", filename: "expo-wall.psb", kind: "canvas", profession: "Exhibition designer", detail: "Large-format canvas", change: "Composition built panel by panel" },
  { ext: "SVG", filename: "brand-mark.svg", kind: "vector", profession: "Brand designer", detail: "Editable vector artwork", change: "Geometry simplified across revisions" },
  { ext: "BLEND", filename: "studio-scene.blend", kind: "scene", profession: "Game environment artist", detail: "Blender scene", change: "Model, materials, lights, and camera" },
  { ext: "OBJ", filename: "chair-study.obj", kind: "mesh", profession: "3D artist", detail: "3D model", change: "Shape and surface refined" },
  { ext: "STEP", filename: "enclosure.step", kind: "cad", profession: "Architect or product designer", detail: "CAD model", change: "Body, ports, edges, and fasteners" },
];

const versions = [1, 2, 3, 4, 5];
const pageTitle = `${content.productName} | Version history for creative work`;
const pageDescription = "Chronicle automatically saves versions of your creative work, explains each change in plain English, and helps you find or restore any version.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={pageTitle} description={pageDescription} pathname="/" pageType="home" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header" aria-label="Site header">
      <a class="brand" href="#top" aria-label="Chronicle home">
        <img class="brand__icon" src={chronicleMarkUrl} alt="" width="26" height="26" />
        {content.productName}
      </a>
      <nav class="nav" aria-label="Primary navigation">
        {content.nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
      <div class="nav-actions">
        <a class="login" href={content.githubUrl} target="_blank" rel="noopener noreferrer">Star on GitHub</a>
        <a class="book" href={content.appUrl} target="_blank" rel="noopener noreferrer">Download</a>
      </div>
    </header>

    <main id="top">
      <!-- ── HERO ─────────────────────────────────────────────────────────── -->
      <div class="hero-stage">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <div class="hero-badge">{content.eyebrow}</div>
            <h1 id="hero-title">{content.headline}</h1>
            <p>{content.subheadline}</p>
            <div class="hero-actions">
              <a class="button button--primary" href={content.appUrl} target="_blank" rel="noopener noreferrer">{content.primaryCta}</a>
              <a class="button button--secondary" href="#how">{content.secondaryCta}</a>
            </div>
            <PlatformAvailability />

            <figure class="hero-mockup" aria-labelledby="product-demo-caption">
              <button class="mockup-plane" type="button" aria-label="Open the Chronicle demo video in full screen" data-fullscreen-trigger>
                <video
                  src="/landing-video.mp4"
                  poster="/chronicle-home.png"
                  width="1919"
                  height="1029"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label="Chronicle capturing, explaining, finding, and restoring versions in a demo project"
                  data-product-demo
                ></video>
                <span class="mockup-fullscreen">Open full screen</span>
              </button>
              <figcaption id="product-demo-caption">A real Chronicle workflow using demo project data. Select the video to watch full screen.</figcaption>
            </figure>
          </div>
        </section>
      </div>

      <!-- ── STATIC FILE-NAMING PROBLEM ─────────────────────────────────── -->
      <section class="history-story" id="why" aria-labelledby="why-title">
        <div class="history-story__heading">
          <p class="pill">Why Chronicle</p>
          <h2 id="why-title">{content.whyTitle}</h2>
          <p class="section-copy">{content.whySubtitle}</p>
        </div>

        <div class="why-files" aria-label="Five conflicting campaign files become one working file with Chronicle">
          <article class="why-files__side why-files__side--messy">
            <header>
              <span>Without Chronicle</span>
              <small>Campaign / exports</small>
            </header>
            <div class="why-files__list">
              {[
                "campaign-final.png",
                "campaign.png",
                "campaign_V2_ok.png",
                "campaign-final-final.png",
                "campaign_V2.png",
              ].map((name) => (
                <div class="why-file">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 2.75h7.2L18 7.55v13.7H6z" />
                    <path d="M13 2.75v5h5" />
                    <path d="m8.5 17 2.4-2.6 1.8 1.8 1.8-2.1 1.5 2.9" />
                  </svg>
                  <strong>{name}</strong>
                </div>
              ))}
            </div>
            <p>Five files. No clear final.</p>
          </article>

          <div class="why-files__bridge" aria-hidden="true">
            <span></span>
            <div class="why-files__logo">
              <img src={chronicleMarkUrl} alt="" width="32" height="32" />
            </div>
            <span></span>
          </div>

          <article class="why-files__side why-files__side--clear">
            <header>
              <span>With Chronicle</span>
              <small>Campaign</small>
            </header>
            <div class="why-file why-file--clean">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 2.75h7.2L18 7.55v13.7H6z" />
                <path d="M13 2.75v5h5" />
                <path d="m8.5 17 2.4-2.6 1.8 1.8 1.8-2.1 1.5 2.9" />
              </svg>
              <strong>campaign.png</strong>
            </div>
            <p>One working file per asset.</p>
          </article>
        </div>
      </section>

      <!-- ── PROOF FACTS ─────────────────────────────────────────────────── -->
      <ul class="proof-facts" aria-label="Key facts">
        <li><strong>8 creative formats</strong><span>targeted for the challenge release</span></li>
        <li><strong>Local</strong><span>version library</span></li>
        <li><strong>No account</strong><span>required</span></li>
        <li><strong>Plain English</strong><span>change explanations</span></li>
      </ul>

      <!-- ── FUSED SCROLL-DRIVEN PRODUCT STORY ────────────────────────── -->
      <section class="process-story" id="how" aria-labelledby="process-title">
        <div class="process-story__heading section-reveal">
          <p class="pill">How it works</p>
          <h2 id="process-title">Choose a folder. Keep creating.</h2>
          <p class="section-copy">Chronicle works in the background. Each save becomes a version you can understand, find, and restore.</p>
        </div>

        <div class="process-pin" data-process-pin>
          <div class="process-frame">
            <header class="process-frame__header">
              <span data-process-count>01 / 04</span>
              <i><b data-process-progress></b></i>
              <span>Scroll to follow one save</span>
            </header>

            <div class="process-copy">
              <article class="process-copy__step" data-process-copy="0">
                <span>01 · Save normally</span>
                <h3>Your tools stay exactly where they are.</h3>
                <p>Choose the folder once, then keep saving from Photoshop, Blender, or the creative tool you already use.</p>
              </article>
              <article class="process-copy__step" data-process-copy="1">
                <span>02 · Captured automatically</span>
                <h3>The save becomes a version.</h3>
                <p>Chronicle records it locally in the background. Nothing waits for AI, and earlier versions remain untouched.</p>
              </article>
              <article class="process-copy__step" data-process-copy="2">
                <span>03 · Explained and found</span>
                <h3>Remember the idea, not the filename.</h3>
                <p>Chronicle explains the visual change, then search finds the version from ordinary words like “the version with the tagline.”</p>
              </article>
              <article class="process-copy__step" data-process-copy="3">
                <span>04 · Restored safely</span>
                <h3>Go back without losing what came after.</h3>
                <p>Restoring version 6 creates a new version 9. The full creative history remains intact.</p>
              </article>
            </div>

            <div class="process-visual" aria-label="One campaign artwork is saved, explained, found, and restored in Chronicle">
              <div class="process-folder" data-process-folder>
                <span>Tracked folder</span>
                <strong>Brand launch</strong>
                <small>campaign.png · watching</small>
              </div>

              <div class="process-canvas" data-process-canvas>
                <span class="process-canvas__eyebrow">Field notes / 2026</span>
                <strong class="process-canvas__title">Make room<br />for the bold.</strong>
                <span class="process-canvas__tagline" data-process-tagline>A creative systems conference</span>
                <div class="process-canvas__tagline-mask" data-process-before-tagline>
                  <span class="process-canvas__tagline process-canvas__tagline--comparison">A creative systems conference</span>
                </div>
                <span class="process-canvas__mark" data-process-mark>C</span>
                <i class="process-canvas__orb process-canvas__orb--one"></i>
                <i class="process-canvas__orb process-canvas__orb--two"></i>
                <div class="process-canvas__wipe" data-process-wipe></div>
                <div class="process-canvas__split-line" data-process-split-line aria-hidden="true"></div>
                <span class="process-callout process-callout--color" data-process-callout>navy → teal</span>
                <span class="process-callout process-callout--tagline" data-process-callout>tagline removed</span>
              </div>

              <div class="process-save-pulse" data-process-pulse aria-hidden="true"></div>
              <div class="process-snapshot" data-process-snapshot aria-hidden="true">
                <span>v8</span>
                <strong>campaign.png</strong>
              </div>

              <aside class="process-timeline" data-process-timeline>
                <header>
                  <span>campaign.png</span>
                  <small>Version history</small>
                </header>
                <div class="process-version process-version--restored" data-process-v9>
                  <span>v9</span>
                  <strong>Restored from version 6</strong>
                  <small>Now</small>
                </div>
                <div class="process-version process-version--latest" data-process-v8>
                  <span>v8</span>
                  <strong>Background changed to teal; tagline removed.</strong>
                  <small>2m ago</small>
                </div>
                <div class="process-version" data-process-v7>
                  <span>v7</span>
                  <strong>Logo mark enlarged and repositioned.</strong>
                  <small>Yesterday</small>
                </div>
                <div class="process-version" data-process-v6>
                  <span>v6</span>
                  <strong>Original tagline beneath the campaign title.</strong>
                  <small>2d ago</small>
                </div>
              </aside>

              <div class="process-summary" data-process-summary>
                <small>What changed · v7 to v8</small>
                <p>The background changed from navy to teal. The tagline was removed and the mark was made larger.</p>
              </div>

              <div class="process-search" data-process-search>
                <span>Search: the version with the tagline</span>
                <small>Found version 6</small>
              </div>

              <div class="process-restore-note" data-process-restore>
                <span>Version 6 restored</span>
                <strong>New version 9 created. History preserved.</strong>
              </div>
            </div>
          </div>
        </div>

        <div class="process-mobile" aria-label="Chronicle workflow">
          {[
            ["01", "Save normally", "Choose a folder once, then keep using the creative tools you already know."],
            ["02", "Captured automatically", "Each save becomes a local version while earlier work remains untouched."],
            ["03", "Explained and found", "Plain-English changes and search bring the remembered version back."],
            ["04", "Restored safely", "Restoring version 6 creates version 9 and preserves the complete history."],
          ].map(([number, title, description]) => (
            <article>
              <span>{number}</span>
              <div><h3>{title}</h3><p>{description}</p></div>
            </article>
          ))}
        </div>
      </section>

      <!-- ── FORMATS ────────────────────────────────────────────────────── -->
      <section class="formats-section section-reveal" id="formats" aria-labelledby="formats-title">
        <div class="formats-heading">
          <p class="pill">Format support</p>
          <h2 id="formats-title">{content.formatsTitle}</h2>
          <p class="section-copy">{content.formatsSubtitle}</p>
        </div>

        <div class="format-marquee" aria-label="Creative file formats shown across five versions">
          <div class="format-marquee__track">
            {[false, true].map((duplicate) => (
              <div class="format-marquee__group" aria-hidden={duplicate ? "true" : undefined}>
                {formatShowcase.map((fmt) => (
                  <article class={`format-story format-story--${fmt.kind}`} aria-label={`${fmt.ext}: ${fmt.change}`}>
                    <header class="format-story__header">
                      <div>
                        <span class="format-story__ext">.{fmt.ext.toLowerCase()}</span>
                        <strong class="format-story__profession">{fmt.profession}</strong>
                        <small class="format-story__filename">{fmt.filename}</small>
                      </div>
                    </header>

                    <div class="format-version-strip" aria-label="Versions 1 through 5">
                      {versions.map((version) => (
                        <div class="format-version" data-version={version}>
                          <div class="format-version__preview" aria-hidden="true">
                            <svg viewBox="0 0 120 84" role="img">
                              {(fmt.kind === "image" || fmt.kind === "photo") && (
                                <>
                                  <rect class="art-sky" width="120" height="84" rx="5" />
                                  <circle class="art-sun v2-up" cx="91" cy="20" r="10" />
                                  <path class="art-mountain" d="M0 67 27 38 47 56 68 27 120 70V84H0Z" />
                                  <path class="art-foreground v3-up" d="M0 69 24 55 46 68 78 46 120 65V84H0Z" />
                                  <rect class="art-lockup v4-up" x="10" y="10" width="34" height="5" rx="2.5" />
                                  <rect class="art-lockup v5-up" x="10" y="19" width="22" height="3" rx="1.5" />
                                </>
                              )}
                              {(fmt.kind === "layers" || fmt.kind === "canvas") && (
                                <>
                                  <rect class="canvas-sheet" x="13" y="8" width="94" height="68" rx="4" />
                                  <rect class="canvas-block" x="22" y="17" width="35" height="42" rx="2" />
                                  <rect class="canvas-title v2-up" x="64" y="18" width="31" height="7" rx="2" />
                                  <rect class="canvas-copy v3-up" x="64" y="31" width="24" height="3" rx="1.5" />
                                  <rect class="canvas-copy v3-up" x="64" y="38" width="30" height="3" rx="1.5" />
                                  <circle class="canvas-accent v4-up" cx="39" cy="38" r="12" />
                                  <rect class="canvas-footer v5-up" x="22" y="64" width="73" height="4" rx="2" />
                                </>
                              )}
                              {fmt.kind === "vector" && (
                                <>
                                  <path class="vector-shape" d="M34 18h36c18 0 25 10 25 23S88 64 70 64H49c-14 0-21-7-21-18 0-10 7-17 21-17h25" />
                                  <circle class="vector-node v2-up" cx="34" cy="18" r="5" />
                                  <circle class="vector-node v3-up" cx="95" cy="41" r="5" />
                                  <path class="vector-cut v4-up" d="m50 29 20 35" />
                                  <circle class="vector-dot v5-up" cx="70" cy="64" r="7" />
                                </>
                              )}
                              {(fmt.kind === "scene" || fmt.kind === "mesh") && (
                                <>
                                  <path class="mesh-face" d="m31 30 32-16 28 17-31 18Z" />
                                  <path class="mesh-side v2-up" d="m31 30 29 19v27L31 56Z" />
                                  <path class="mesh-side mesh-side--light v2-up" d="m60 49 31-18v27L60 76Z" />
                                  <path class="mesh-wire v3-up" d="m31 30 60 28M63 14l-3 62M31 56l60-25" />
                                  <circle class="mesh-orbit v4-up" cx="60" cy="46" r="36" />
                                  <path class="mesh-light v5-up" d="m96 10-8 12m15-5-12 8" />
                                </>
                              )}
                              {fmt.kind === "cad" && (
                                <>
                                  <path class="cad-body" d="M21 29 54 12l45 22-34 19-44-20Z" />
                                  <path class="cad-side v2-up" d="m21 33 44 20v20L21 52Z" />
                                  <path class="cad-side cad-side--light v2-up" d="m65 53 34-19v19L65 73Z" />
                                  <circle class="cad-port v3-up" cx="39" cy="49" r="5" />
                                  <circle class="cad-port v4-up" cx="81" cy="50" r="4" />
                                  <path class="cad-dimension v5-up" d="M16 76h88M16 72v8m88-8v8" />
                                </>
                              )}
                            </svg>
                          </div>
                          <span>v{version}</span>
                        </div>
                      ))}
                    </div>

                    <footer class="format-story__footer">
                      <span>{fmt.detail}</span>
                      <strong>{fmt.change}</strong>
                    </footer>
                  </article>
                ))}
              </div>
            ))}
          </div>
        </div>

      </section>

      <!-- ── TRUST AND EXECUTION ───────────────────────────────────────── -->
      <section class="trust section-reveal" aria-labelledby="trust-title">
        <div class="trust-copy">
          <p class="pill">Made for real work</p>
          <h2 id="trust-title">Your creative history stays yours.</h2>
          <p class="section-copy">Chronicle saves every version on your computer, even while you are offline. AI is optional and uses your own provider key, stored securely on your device. If you save while offline, Chronicle adds the explanation when you reconnect. No account is required. If you choose to sign in, settings sync and encrypted key backup can be enabled separately.</p>
        </div>
        <div class="bob-story">
          <span class="bob-story__label">Built with IBM Bob</span>
          <h3>From first plan to working product.</h3>
          <p>We used IBM Bob to plan Chronicle, build its core features, test real creative workflows, solve integration problems, and prepare the app for release.</p>
          <a href={content.githubUrl} target="_blank" rel="noopener noreferrer">Explore the public project on GitHub</a>
        </div>
      </section>

      <!-- ── DOWNLOAD ───────────────────────────────────────────────────── -->
      <section class="templates section-reveal" id="download" aria-labelledby="download-title">
        <p class="pill">Start your history</p>
        <h2 id="download-title">{content.downloadTitle}</h2>
        <p>{content.downloadSubtitle}</p>
        <div class="hero-actions">
          <a class="button button--primary" href={content.appUrl} target="_blank" rel="noopener noreferrer">{content.downloadCta}</a>
          <a class="button button--secondary button--github" href={content.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="Star Chronicle on GitHub and support the project">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path d="m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            {content.downloadSecondaryCta}
          </a>
        </div>
        <PlatformAvailability />
        <p class="github-support">A star helps more creators and judges discover the project.</p>
      </section>

    </main>

    <footer class="site-footer">
      <span>Chronicle · Local-first creative version control</span>
      <nav aria-label="Footer navigation">
        <a href="/help/">Help center</a>
        <a href="/about/">About Chronicle</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms-and-services/">Terms of Service</a>
        <a href={content.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </footer>

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const mm = gsap.matchMedia();
      const productDemo = document.querySelector("[data-product-demo]") as HTMLVideoElement | null;
      const fullscreenTrigger = document.querySelector("[data-fullscreen-trigger]") as HTMLButtonElement | null;

      fullscreenTrigger?.addEventListener("click", async () => {
        if (!productDemo) return;

        if (productDemo.requestFullscreen) {
          try {
            await productDemo.requestFullscreen();
          } catch {
            productDemo.controls = true;
          }
          return;
        }

        const iosVideo = productDemo as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
        iosVideo.webkitEnterFullscreen?.();
      });

      document.addEventListener("fullscreenchange", () => {
        if (productDemo) productDemo.controls = document.fullscreenElement === productDemo;
      });

      // Formats marquee: auto-scrolls infinitely, but a manual drag/scroll takes
      // over; auto resumes 500ms after the last interaction.
      const marquee = document.querySelector<HTMLElement>(".format-marquee");
      const marqueeTrack = marquee?.querySelector<HTMLElement>(".format-marquee__track");

      if (marquee && marqueeTrack && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const SPEED = 40; // px per second
        const RESUME_DELAY = 500; // ms of no interaction before auto resumes
        let auto = true;
        let resumeTimer: number | undefined;
        let last: number | null = null;

        // One of the two identical groups; wrapping at this width loops seamlessly.
        const loopWidth = () => marqueeTrack.scrollWidth / 2;

        const bump = () => {
          auto = false;
          if (resumeTimer) window.clearTimeout(resumeTimer);
          resumeTimer = window.setTimeout(() => {
            auto = true;
          }, RESUME_DELAY);
        };

        (["pointerdown", "wheel", "touchstart", "touchmove", "keydown"] as const).forEach((evt) =>
          marquee.addEventListener(evt, bump, { passive: true }),
        );

        const tick = (now: number) => {
          if (last === null) last = now;
          const dt = (now - last) / 1000;
          last = now;
          const half = loopWidth();

          if (half > 0) {
            if (auto) {
              let next = marquee.scrollLeft + SPEED * dt;
              if (next >= half) next -= half;
              marquee.scrollLeft = next;
            } else if (marquee.scrollLeft >= half) {
              // Keep manual scrolling inside the first copy so the loop stays infinite.
              marquee.scrollLeft -= half;
            }
          }

          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      mm.add(
        {
          isDesktop: "(min-width: 769px)",
          isMobile: "(max-width: 768px)",
          reduceMotion: "(prefers-reduced-motion: reduce)",
          animate: "(prefers-reduced-motion: no-preference)",
        },
        (context) => {
          if (context.conditions.reduceMotion) {
            productDemo?.pause();
            return;
          }

          productDemo?.play().catch(() => {
            // The poster remains visible if the browser blocks autoplay.
          });

          gsap.from(".site-header", {
            autoAlpha: 0,
            y: -16,
            duration: 0.7,
            ease: "power3.out",
          });

          gsap.from(".hero-badge, .hero-copy > *, .hero-mockup", {
            autoAlpha: 0,
            y: 28,
            duration: 0.8,
            ease: "power3.out",
            stagger: 0.08,
          });

          gsap.from(".proof-facts li", {
            autoAlpha: 0,
            y: 12,
            duration: 0.5,
            ease: "power3.out",
            stagger: 0.06,
            scrollTrigger: { trigger: ".proof-facts", start: "top 88%" },
          });

          if (context.conditions.isDesktop) {
            const processPin = document.querySelector<HTMLElement>("[data-process-pin]");
            const processCount = document.querySelector<HTMLElement>("[data-process-count]");
            const processProgress = document.querySelector<HTMLElement>("[data-process-progress]");
            const processCopy = gsap.utils.toArray<HTMLElement>("[data-process-copy]");
            const processFolder = document.querySelector<HTMLElement>("[data-process-folder]");
            const processCanvas = document.querySelector<HTMLElement>("[data-process-canvas]");
            const processTagline = document.querySelector<HTMLElement>("[data-process-tagline]");
            const processBeforeTagline = document.querySelector<HTMLElement>("[data-process-before-tagline]");
            const processMark = document.querySelector<HTMLElement>("[data-process-mark]");
            const processWipe = document.querySelector<HTMLElement>("[data-process-wipe]");
            const processSplitLine = document.querySelector<HTMLElement>("[data-process-split-line]");
            const processCallouts = gsap.utils.toArray<HTMLElement>("[data-process-callout]");
            const processPulse = document.querySelector<HTMLElement>("[data-process-pulse]");
            const processSnapshot = document.querySelector<HTMLElement>("[data-process-snapshot]");
            const processTimeline = document.querySelector<HTMLElement>("[data-process-timeline]");
            const processV6 = document.querySelector<HTMLElement>("[data-process-v6]");
            const processV8 = document.querySelector<HTMLElement>("[data-process-v8]");
            const processV9 = document.querySelector<HTMLElement>("[data-process-v9]");
            const processSummary = document.querySelector<HTMLElement>("[data-process-summary]");
            const processSearch = document.querySelector<HTMLElement>("[data-process-search]");
            const processRestore = document.querySelector<HTMLElement>("[data-process-restore]");

            if (
              processPin && processProgress && processCopy.length === 4 && processFolder &&
              processCanvas && processTagline && processBeforeTagline && processMark && processWipe && processSplitLine && processPulse &&
              processSnapshot && processTimeline && processV6 && processV8 && processV9 &&
              processSummary && processSearch && processRestore
            ) {
              gsap.set(processCopy, { yPercent: 0 });
              gsap.set(processCopy.slice(1), { autoAlpha: 0, y: 24 });
              gsap.set(processTimeline, { autoAlpha: 0, x: 48 });
              gsap.set(processV9, { autoAlpha: 0, y: -12 });
              gsap.set(processWipe, { scaleX: 0 });
              gsap.set(processSplitLine, { autoAlpha: 0, scaleY: 0.82 });
              gsap.set(processBeforeTagline, { autoAlpha: 0 });
              gsap.set(processCallouts, { autoAlpha: 0, x: 12 });
              gsap.set([processSummary, processSearch, processRestore], { autoAlpha: 0, y: 14 });
              gsap.set(processSnapshot, { autoAlpha: 0, x: 0, y: 0, scale: 0.78 });
              gsap.set(processPulse, { autoAlpha: 0, scale: 0.65 });
              gsap.set(processProgress, { scaleX: 0 });

              const showProcessCopy = (timeline: gsap.core.Timeline, from: number, to: number, at: number) => {
                timeline
                  .to(processCopy[from], { autoAlpha: 0, y: -22, duration: 0.65 }, at)
                  .to(processCopy[to], { autoAlpha: 1, y: 0, duration: 0.82 }, at + 0.28);
              };

              const processSequence = gsap.timeline({
                defaults: { ease: "power3.inOut" },
                scrollTrigger: {
                  trigger: processPin,
                  start: "top 14%",
                  end: "+=2600",
                  pin: true,
                  scrub: 0.75,
                  anticipatePin: 1,
                  onUpdate: ({ progress }) => {
                    const step = Math.min(4, Math.floor(progress * 4) + 1);
                    if (processCount) processCount.textContent = `0${step} / 04`;
                  },
                },
              });

              processSequence.to(processProgress, { scaleX: 1, duration: 12, ease: "none" }, 0);

              showProcessCopy(processSequence, 0, 1, 2.1);
              processSequence
                .to(processFolder, { autoAlpha: 0, y: -18, duration: 0.75 }, 2.15)
                .to(processPulse, { autoAlpha: 0.82, scale: 1.15, duration: 0.5 }, 2.2)
                .to(processPulse, { autoAlpha: 0, scale: 1.5, duration: 0.72 }, 2.7)
                .to(processSnapshot, { autoAlpha: 1, scale: 1, duration: 0.55 }, 2.28)
                .to(
                  processSnapshot,
                  {
                    x: () => Math.max(170, processPin.clientWidth * 0.24),
                    y: -128,
                    scale: 0.55,
                    autoAlpha: 0,
                    duration: 1.15,
                  },
                  2.82,
                )
                .to(processCanvas, { backgroundColor: "#0d6f70", duration: 1.05 }, 2.45)
                .to(processTagline, { autoAlpha: 0, y: 8, duration: 0.65 }, 2.55)
                .to(processMark, { scale: 1.18, duration: 0.72 }, 2.5)
                .to(processTimeline, { autoAlpha: 1, x: 0, duration: 1.05 }, 2.7);

              showProcessCopy(processSequence, 1, 2, 5.0);
              processSequence
                .to(processWipe, { scaleX: 1, duration: 0.92 }, 5.05)
                .to(processSplitLine, { autoAlpha: 1, scaleY: 1, duration: 0.42 }, 5.15)
                .to(processBeforeTagline, { autoAlpha: 1, duration: 0.42 }, 5.28)
                .to(processCallouts, { autoAlpha: 1, x: 0, duration: 0.72, stagger: 0.12 }, 5.55)
                .to(processSummary, { autoAlpha: 1, y: 0, duration: 0.82 }, 6.15)
                .to(processCallouts, { autoAlpha: 0, x: 10, duration: 0.55, stagger: 0.08 }, 6.65)
                .to(processBeforeTagline, { autoAlpha: 0, duration: 0.38 }, 6.68)
                .to(processSplitLine, { autoAlpha: 0, scaleY: 0.82, duration: 0.38 }, 6.68)
                .to(processWipe, { scaleX: 0, duration: 0.7 }, 6.72)
                .to(processSummary, { autoAlpha: 0, y: 10, duration: 0.55 }, 7.1)
                .to(processSearch, { autoAlpha: 1, y: 0, duration: 0.72 }, 7.18)
                .to(processV8, { borderColor: "transparent", backgroundColor: "transparent", duration: 0.55 }, 7.25)
                .to(processCanvas, { backgroundColor: "#20365f", duration: 0.85 }, 7.24)
                .to(processTagline, { autoAlpha: 1, y: 0, duration: 0.65 }, 7.3)
                .to(processMark, { scale: 0.86, duration: 0.65 }, 7.28)
                .to(
                  processV6,
                  {
                    borderColor: "rgba(120, 169, 255, 0.28)",
                    backgroundColor: "rgba(15, 98, 254, 0.09)",
                    color: "#c5d9fa",
                    duration: 0.6,
                  },
                  7.32,
                );

              showProcessCopy(processSequence, 2, 3, 8.65);
              processSequence
                .to(processSearch, { autoAlpha: 0, y: -10, duration: 0.55 }, 8.62)
                .to(processV9, { autoAlpha: 1, y: 0, duration: 0.82 }, 9.05)
                .to(processRestore, { autoAlpha: 1, y: 0, duration: 0.82 }, 9.35);
            }
          }

          gsap.utils.toArray(".section-reveal").forEach((section) => {
            gsap.from(
              (section as Element).querySelectorAll(
                "h2, h3, .pill, .section-copy, .format-marquee, .bob-story"
              ),
              {
                autoAlpha: 0,
                y: 26,
                duration: 0.62,
                ease: "power3.out",
                stagger: 0.05,
                scrollTrigger: {
                  trigger: section as Element,
                  start: "clamp(top 74%)",
                },
              }
            );
          });
        },
      );

    </script>
  </body>
</html>
